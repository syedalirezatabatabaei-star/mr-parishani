{
  "name": "@sepehr/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "files": [
    "dist",
    "drizzle",
    "data-dictionary"
  ],
  "exports": {
    "./telemetry": {
      "types": "./dist/infra/telemetry.d.ts",
      "default": "./dist/infra/telemetry.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && sh ../../scripts/ci/db-drift.sh",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap": "node --env-file-if-exists=../../.env dist/db/cli/bootstrap.js",
    "db:migrate": "node --env-file-if-exists=../../.env dist/db/cli/migrate.js",
    "db:data-dictionary": "node --env-file-if-exists=../../.env dist/db/cli/data-dictionary.js",
    "account:create": "node --env-file-if-exists=../../.env dist/modules/identity/cli/create-account.js",
    "identity:first-approver-mobile": "node --env-file-if-exists=../../.env dist/modules/identity/cli/set-first-approver-mobile.js",
    "access:grant": "node --env-file-if-exists=../../.env dist/modules/access/cli/grant-role.js",
    "security:reencrypt": "node --env-file-if-exists=../../.env dist/modules/audit/cli/reencrypt.js",
    "lead:backfill-persons": "node --env-file-if-exists=../../.env dist/modules/identity/cli/backfill-persons.js",
    "catalog:rebuild-search": "node --env-file-if-exists=../../.env dist/modules/catalog/cli/rebuild-search.js",
    "contract:post-down-payments": "node --env-file-if-exists=../../.env dist/modules/contract/cli/post-down-payments.js",
    "settlement:backfill-payables": "node --env-file-if-exists=../../.env dist/modules/settlement/cli/backfill-payables.js",
    "collection:run-cycle": "node --env-file-if-exists=../../.env dist/modules/collection/cli/run-cycle.js",
    "reporting:refresh-views": "node --env-file-if-exists=../../.env dist/modules/reporting/cli/refresh-views.js",
    "reporting:search-insights": "node --env-file-if-exists=../../.env dist/modules/reporting/cli/search-insights.js",
    "settlement:generate-statements": "node --env-file-if-exists=../../.env dist/modules/settlement/cli/generate-statements.js",
    "ops:partitions": "node --env-file-if-exists=../../.env dist/infra/ops/cli/partitions.js",
    "ops:launch-check": "node --env-file-if-exists=../../.env dist/infra/ops/cli/launch-check.js",
    "ops:outbox-requeue": "node --env-file-if-exists=../../.env dist/infra/ops/cli/outbox-requeue.js",
    "openapi": "node dist/openapi/cli/generate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "2.2.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-ioredis": "0.70.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.68.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sepehr/contracts": "workspace:*",
    "bullmq": "6.3.6",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "playwright-core": "1.63.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.3",
    "@sepehr/config": "workspace:*",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.1"
  }
}
