{
  "name": "@sepehr/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./csp": {
      "types": "./dist/web/csp.d.ts",
      "default": "./dist/web/csp.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts/*": "./fonts/*",
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/write-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sepehr/config": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@sepehr/api-client": "workspace:*",
    "@sepehr/contracts": "workspace:*",
    "uqr": "0.1.3"
  }
}
