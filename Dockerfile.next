# Production image for a Next.js app of this monorepo (the patient web app or the internal
# panel). Build from the repository root:
#   docker build -f Dockerfile.next --build-arg APP=web -t sepehr-web .
#   docker build -f Dockerfile.next --build-arg APP=admin -t sepehr-admin .
# The app is built as Next's standalone server (NEXT_OUTPUT=standalone, next.config.ts): its
# traced files only, started with `node apps/<app>/server.js`. Fonts are self-hosted inside the
# build (next/font/local); nothing is fetched at run time (rules 17–20).

FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]
ARG APP
RUN case "$APP" in web|admin) ;; *) echo 'Pass --build-arg APP=web or APP=admin' >&2; exit 1 ;; esac
RUN corepack enable
WORKDIR /repo
ENV NEXT_TELEMETRY_DISABLED=1

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
RUN pnpm fetch

COPY . .
RUN pnpm install --offline --frozen-lockfile
RUN NEXT_OUTPUT=standalone pnpm turbo run build --filter="@sepehr/${APP}..."
# The standalone server serves .next/static once it sits beside it.
RUN mkdir -p /out && cp -r "apps/${APP}/.next/standalone/." /out/ \
  && mkdir -p "/out/apps/${APP}/.next" && cp -r "apps/${APP}/.next/static" "/out/apps/${APP}/.next/static"

FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
ARG APP
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    APP_DIR=apps/${APP}
# As the services' image (task 9-3, R16): the app runs `node server.js` only.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack       /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /opt/yarn*       /usr/local/bin/yarn /usr/local/bin/yarnpkg
WORKDIR /app
COPY --from=build --chown=node:node /out ./
USER node
# PORT: 3001 for web, 3002 for admin, set by the deployment (docs/ops/deployment/05-application.md).
CMD ["sh", "-c", "exec node \"$APP_DIR/server.js\""]
