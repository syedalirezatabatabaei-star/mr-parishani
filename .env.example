# Local development only. Copy to .env and change the values.
POSTGRES_USER=sepehr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sepehr
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database roles (task 0-3), created by `pnpm db:bootstrap`. Use a long random password
# (at least 16 characters) for each.
DB_OWNER_PASSWORD=change-me-owner-password
DB_APP_PASSWORD=change-me-app-password
# Read-only role for reports and reconciliation (task 1-4).
DB_REPORT_PASSWORD=change-me-report-password
# Connection URLs. The port must match POSTGRES_PORT above.
# Superuser: used only by `pnpm db:bootstrap`.
DB_ADMIN_URL=postgres://sepehr:change-me@127.0.0.1:5432/sepehr
# Schema owner: used only by `pnpm db:migrate`.
MIGRATION_DATABASE_URL=postgres://sepehr_owner:change-me-owner-password@127.0.0.1:5432/sepehr
# The application, with least privilege.
DATABASE_URL=postgres://sepehr_app:change-me-app-password@127.0.0.1:5432/sepehr
# Reports and reconciliation read here (ADR-012, ADR-020): the read-only replica in
# production (required there). Empty in development: the primary database is used.
REPORTING_DATABASE_URL=

# Identity and sessions (task 0-4).
NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379
# 32 random bytes each, base64: `openssl rand -base64 32`. Never reuse one for the other.
AUTH_SECRET=
FIELD_ENCRYPTION_KEY=
# Keyed blind index of encrypted identifiers (task 2-2); a third, separate key.
BLIND_INDEX_KEY=
# Origins allowed to send state-changing requests with the session cookie.
WEB_ORIGINS=http://localhost:3001,http://localhost:3002
# Proxies trusted to report the client IP (Express "trust proxy"); empty = none.
TRUST_PROXY=
# The API's listen address: 127.0.0.1 when unset (owner 1405/08/09); the API image sets 0.0.0.0.
# HOST=127.0.0.1
# The internal panel's networks (R10, task 9-3), comma-separated CIDRs: the VPN's range, or the
# office's address where there is no VPN. Empty with an empty versioned list = closed to every
# internal role. On this machine: 127.0.0.1/32,::1/128.
INTERNAL_PANEL_CIDRS=127.0.0.1/32,::1/128
# Web and admin apps (task 2-11): where the API listens, seen from their servers. Browsers
# call /api/v1 on the app's own origin, which the app passes on to this address.
API_INTERNAL_URL=http://localhost:3000
# The public address of the web app: canonical links of the doctors' pages (doc 08 §10).
PUBLIC_WEB_ORIGIN=http://localhost:3001
# The patient site's address as the internal panel names it (task 8-3: the profile link list).
PATIENT_WEB_ORIGIN=http://localhost:3001
# Origin of signed file links when the S3 store is on another host; empty = same origin.
MEDIA_ORIGIN=
# kavenegar, or fake (prints codes; only with NODE_ENV=development).
SMS_PROVIDER=fake
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
# Kavenegar sender line for appointment SMS (task 2-6). Empty: the worker still starts and
# login codes still go out; appointment texts fail after their retries (never sent late).
KAVENEGAR_SENDER=

# Leads (task 2-5b): HMAC secrets of the WordPress webhook, `new,old` for rotation, each at
# least 32 random characters. Empty: the webhook answers 503.
LEAD_WEBHOOK_SECRETS_WORDPRESS=

# Outbox, queues and monitoring (task 0-7). The worker also needs DATABASE_URL and REDIS_URL.
# On-call mobiles for critical alerts by SMS, comma-separated; required in production.
ALERT_SMS_MOBILES=
# Kavenegar template for alerts (its token is the alert code); needed with ALERT_SMS_MOBILES.
KAVENEGAR_ALERT_TEMPLATE=
# Alertmanager's webhook into the same on-call SMS (task 10-3): both or neither; the token
# at least 32 characters (Alertmanager reads it from a file). Host 127.0.0.1 unless set.
ALERTMANAGER_WEBHOOK_PORT=
ALERTMANAGER_WEBHOOK_TOKEN=
ALERTMANAGER_WEBHOOK_HOST=
# Self-hosted OpenTelemetry collector (OTLP/HTTP), e.g. http://otel-collector:4318.
# Empty: telemetry is off and nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Profile media (task 2-8). All S3_* set, or none (uploads are then refused).
# Locally, with the seaweedfs service of docker-compose.yml: S3_ENDPOINT=http://127.0.0.1:8333,
# S3_PRIVATE_BUCKET=sepehr-private, S3_PUBLIC_BUCKET=sepehr-public,
# S3_PUBLIC_BASE_URL=http://127.0.0.1:8333/sepehr-public, and any non-empty key and secret.
S3_PORT=8333
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
S3_PUBLIC_BASE_URL=
# The clamav service; empty CLAMAV_HOST refuses every upload.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Only for catalog.profile_video_hosting = self (HLS in the worker).
FFMPEG_PATH=
FFPROBE_PATH=
